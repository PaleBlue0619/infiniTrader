{
  "session": {
    "host": "localhost",
    "port": 8848,
    "userid": "admin",
    "password": "123456"
  },
  "record": { // 合约基本信息(盘前集中获取) + 盘中行为(trade & order-已发送) + 状态(position & order-待发送)记录
    "infoTable": "realTimeInfo",
    "orderTable": "realTimeOrder",
    "tradeTable": "realTimeTrade",
    "dropTB": true,
    "pathStr": "E://Quant//QuantTrader//infiniTrader//cons",
    "marginFile": "0522.xls", // from 交易星球保证金数据: https://www.jiaoyixingqiu.com/shouxufei/all
    "infiniFile": "infiniTrader.xlsx", // 无限易主力合约实时更新excel
    "longPosFile": "longPos.json5", // 持仓Json5名称
    "shortPosFile": "shortPos.json5",
    "orderFile": "order.json5"
  },
  "infoFile": "E://Quant//QuantTrader//infiniTrader//cons//infoDict.json5",
  /*
  强制包含:
  exchange: 交易所
  multi: 交易乘数
  format: 格式
  nightTime: 夜盘时间
  dayTime: 日盘时间
  (剩余信息在on_start中进行补充, 最终输出完整的self.infoDict)
  */
  "signalFile": null, // "E://Quant//PyBackTest//test//futStrategy//realTimeSignal.csv",
  /*
  强制包含:
  product: 品种名称
  symbol: 合约名称
  direction: 交易方向
  price: 合约最新价 -> 用于计算 vol & volume
  amount: 给这个合约+方向的资金总额
  minPosTimestamp: 最短持仓时间
  maxPosTimestamp: 最长持仓时间
  upLimit: 多单止盈+空单止损比例
  downLimit: 多单止损+空单止盈比例
  */
  "deleteProduct": ["JR","RI","PM","WH","ZC"] // 剔除奇奇怪怪的无法交易的品种(但无限易里面好像还有)
}